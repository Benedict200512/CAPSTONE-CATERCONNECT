  "function_definitions": [
    {
      "acl": [
        "postgres=X/postgres",
        "service_role=X/postgres"
      ],
      "owner": "postgres",
      "signature": "check_package_limit()",
      "definition": "CREATE OR REPLACE FUNCTION public.check_package_limit()\\n RETURNS trigger\\n LANGUAGE plpgsql\\n SECURITY DEFINER\\nAS $function$\\r\\ndeclare\\r\\n  pkg_count int;\\r\\n  plan_limit int;\\r\\n  caterer_plan text;\\r\\nbegin\\r\\n  select subscription_plan into caterer_plan from caterers where id = new.caterer_id;\\r\\n  select max_packages into plan_limit from subscription_plans where id = caterer_plan;\\r\\n  \\r\\n  -- null means unlimited\\r\\n  if plan_limit is null then\\r\\n    return new;\\r\\n  end if;\\r\\n\\r\\n  select count(*) into pkg_count from packages where caterer_id = new.caterer_id;\\r\\n  \\r\\n  if pkg_count >= plan_limit then\\r\\n    raise exception 'Package limit reached for your current plan. Upgrade to add more packages.';\\r\\n  end if;\\r\\n  \\r\\n  return new;\\r\\nend;\\r\\n$function$\\n",
      "configuration": null,
      "security_definer": true
    }
  ],
