    "policies": [
      {
        "name": "Caterer reads own refund submissions",
        "roles": [
          "16485"
        ],
        "using": "(EXISTS ( SELECT 1\n   FROM caterers c\n  WHERE ((c.id = refund_transfer_submissions.caterer_id) AND (((c.id)::text = (auth.uid())::text) OR ((to_jsonb(c.*) ->> 'user_id'::text) = (auth.uid())::text)))))",
        "command": "r",
        "permissive": true,
        "with_check": null
      },
      {
        "name": "Customer sees own refund submission status",
        "roles": [
          "16485"
        ],
        "using": "(EXISTS ( SELECT 1\n   FROM bookings b\n  WHERE ((b.id = refund_transfer_submissions.booking_id) AND (b.customer_id = ( SELECT auth.uid() AS uid)))))",
        "command": "r",
        "permissive": true,
        "with_check": null
      },
      {
        "name": "Refund staff view transfer submissions",
        "roles": [
          "16485"
        ],
        "using": "is_refund_staff()",
        "command": "r",
        "permissive": true,
        "with_check": null
      }
    ],
    "triggers": [
      {
        "name": "set_refund_submission_lateness_trigger",
        "enabled": "O",
        "definition": "CREATE TRIGGER set_refund_submission_lateness_trigger BEFORE INSERT ON public.refund_transfer_submissions FOR EACH ROW EXECUTE FUNCTION set_refund_submission_lateness()",
        "configuration": [
          "search_path=\"\""
        ],
        "function_owner": "postgres",
        "security_definer": true,
        "function_definition": "CREATE OR REPLACE FUNCTION public.set_refund_submission_lateness()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nDECLARE\r\n  v_refund_due_at timestamptz;\r\n  v_refund_status text;\r\n  v_booking_caterer_id uuid;\r\nBEGIN\r\n  SELECT\r\n    b.refund_due_at,\r\n    b.refund_status,\r\n    b.caterer_id\r\n  INTO\r\n    v_refund_due_at,\r\n    v_refund_status,\r\n    v_booking_caterer_id\r\n  FROM public.bookings b\r\n  WHERE b.id = NEW.booking_id\r\n  FOR UPDATE;\r\n\r\n  IF NOT FOUND THEN\r\n    RAISE EXCEPTION 'Booking not found'\r\n      USING ERRCODE = '23503';\r\n  END IF;\r\n\r\n  IF NEW.caterer_id IS DISTINCT FROM v_booking_caterer_id THEN\r\n    RAISE EXCEPTION 'Refund submission caterer does not match booking'\r\n      USING ERRCODE = '42501';\r\n  END IF;\r\n\r\n  IF v_refund_status NOT IN ('pending', 'overdue') THEN\r\n    RAISE EXCEPTION 'Booking is not awaiting refund transfer proof'\r\n      USING ERRCODE = '23514';\r\n  END IF;\r\n\r\n  IF v_refund_due_at IS NULL THEN\r\n    RAISE EXCEPTION 'Refund deadline is missing'\r\n      USING ERRCODE = '23514';\r\n  END IF;\r\n\r\n  -- Always use the database clock, never a client-supplied timestamp.\r\n  NEW.submitted_at := clock_timestamp();\r\n\r\n  NEW.submitted_late :=\r\n    NEW.submitted_at > v_refund_due_at;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
      },
      {
        "name": "trg_notify_refund_transfer_evidence_created",
        "enabled": "O",
        "definition": "CREATE TRIGGER trg_notify_refund_transfer_evidence_created AFTER INSERT ON public.refund_transfer_submissions FOR EACH ROW EXECUTE FUNCTION notify_refund_transfer_evidence_created()",
        "configuration": [
          "search_path=\"\""
        ],
        "function_owner": "postgres",
        "security_definer": true,
        "function_definition": "CREATE OR REPLACE FUNCTION public.notify_refund_transfer_evidence_created()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nDECLARE\r\n  v_customer_id uuid;\r\nBEGIN\r\n  SELECT b.customer_id INTO v_customer_id\r\n  FROM public.bookings b\r\n  WHERE b.id = NEW.booking_id\r\n    AND b.status = 'cancelled'\r\n    AND COALESCE(b.refund_amount, 0) > 0;\r\n\r\n  IF v_customer_id IS NOT NULL THEN\r\n    INSERT INTO public.notifications\r\n      (user_id, title, message, type, booking_id, is_read)\r\n    VALUES\r\n      (v_customer_id,\r\n       'Refund Transfer Submitted',\r\n       'The caterer submitted refund transfer evidence. Check your wallet or bank account and confirm receipt only after the funds arrive.',\r\n       'refund_transfer_submitted',\r\n       NEW.booking_id,\r\n       false);\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
      }
    ],
