"\r\nBEGIN\r\n  INSERT INTO public.profiles (\r\n    id, \r\n    email, \r\n    full_name, \r\n    role, \r\n    phone_number, \r\n    address,\r\n    business_name,\r\n    city\r\n  )\r\n  VALUES (\r\n    new.id,\r\n    new.email,\r\n    COALESCE(new.raw_user_meta_data->>'full_name', ''),\r\n    COALESCE(new.raw_user_meta_data->>'role', 'customer'),\r\n    NULLIF(new.raw_user_meta_data->>'phone_number', ''),\r\n    NULLIF(new.raw_user_meta_data->>'address', ''),\r\n    NULLIF(new.raw_user_meta_data->>'business_name', ''),\r\n    NULLIF(new.raw_user_meta_data->>'city', '')\r\n  )\r\n  ON CONFLICT (id) DO UPDATE SET\r\n    full_name = EXCLUDED.full_name,\r\n    role = EXCLUDED.role,\r\n    phone_number = COALESCE(NULLIF(EXCLUDED.phone_number, ''), profiles.phone_number),\r\n    address = COALESCE(NULLIF(EXCLUDED.address, ''), profiles.address),\r\n    business_name = COALESCE(NULLIF(EXCLUDED.business_name, ''), profiles.business_name),\r\n    city = COALESCE(NULLIF(EXCLUDED.city, ''), profiles.city);\r\n  RETURN NEW;\r\nEND;\r\n"
